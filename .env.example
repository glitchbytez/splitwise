# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Spring profile: local | prod
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (used by the db container and to build the app's DB_URL in docker-compose.yml)
POSTGRES_DB=splitwise
POSTGRES_USER=splitwise
POSTGRES_PASSWORD=change-me

# Host ports
DB_PORT=5433
APP_PORT=8080

# When running the jar outside Docker, the app reads these directly:
# DB_URL=jdbc:postgresql://localhost:5433/splitwise
# DB_USER=splitwise
# DB_PASSWORD=change-me

# JWT signing secret: at least 32 bytes, e.g. `openssl rand -base64 48`.
# Required in prod. Leave empty locally to use the development-only fallback.
JWT_SECRET=
